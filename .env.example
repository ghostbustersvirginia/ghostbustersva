# Environment variable template
# Copy to .env for local development and set matching values in Vercel.

# Primary production origin used for canonical tags and sitemap generation.
SITE_URL=https://ghostbustersva.com

# Resend email delivery (required)
RESEND_API_KEY=re_your_key_here
CONTACT_FROM_EMAIL=hello@yourdomain.com
CONTACT_TO_EMAIL=your-inbox@example.com

# Upstash Redis rate limiting (recommended — memory fallback used if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional — leave blank unless you intentionally enable it)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps (existing)
# GOOGLE_MAPS_API_KEY=

# Google Calendar, etc. Member Site
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GBVA_EVENTS_CALENDAR_ID="your-calendar-id@group.calendar.google.com"
GBVA_MEMBERS_GROUP="all-members@ghostbustersva.com"
GBVA_ORGANIZERS_GROUP="officers@ghostbustersva.com"
GOOGLE_ACCESS_MODE="direct"
GCP_PROJECT_NUMBER="123456789012"
GCP_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GCP_WORKLOAD_IDENTITY_POOL_ID="vercel"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="vercel"

# secrets for member site
CALENDAR_WEBHOOK_TOKEN=
CRON_SECRET=
SESSION_SECRET=

# Optional overrides (defaults shown)
# GOOGLE_DELEGATED_USER=calendar-automation@ghostbustersva.com   # only when GOOGLE_ACCESS_MODE=delegated
# GOOGLE_SERVICE_ACCOUNT_KEY=   # base64 JSON key; fallback when Workload Identity Federation isn't used
# MEMBERSHIP_TTL_MINUTES=720
# LATE_CHANGE_WINDOW_MINUTES=120
# LATE_CHANGE_RETENTION_DAYS=730
