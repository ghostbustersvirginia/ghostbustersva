{
  "name": "ghostbustersva",
  "type": "module",
  "version": "0.1.0",
  "description": "Ghostbusters Virginia — community franchise website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.15.10",
    "@astrojs/react": "^5.0.3",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.4",
    "@fullcalendar/react": "^7.1.5",
    "@ghostbustersva/readyled": "^0.1.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "@vercel/oidc": "^4.0.9",
    "astro": "^5.17.1",
    "google-auth-library": "^11.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.7.0",
    "resend": "^6.12.2",
    "sanitize-html": "^2.18.2",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/google.maps": "^3.58.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-astro": "^1.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
