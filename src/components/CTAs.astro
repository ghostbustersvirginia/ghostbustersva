---
import Button from "./ui/Button.astro";

interface Props {
  primaryCtaLabel: string;
  primaryCtaHref: string;
  primaryCtaExternal?: boolean;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaExternal?: boolean;
  tertiaryCtaLabel?: string;
  tertiaryCtaHref?: string;
  tertiaryCtaExternal?: boolean;
}

const {
  primaryCtaLabel,
  primaryCtaHref,
  primaryCtaExternal = false,
  secondaryCtaLabel,
  secondaryCtaHref,
  secondaryCtaExternal = false,
  tertiaryCtaLabel,
  tertiaryCtaHref,
  tertiaryCtaExternal = false,
} = Astro.props;
---

<Button
  variant="primary"
  class="btn--lg btn--donate-hero"
  href={primaryCtaHref}
  external={primaryCtaExternal}
>
  {primaryCtaLabel}
</Button>
{
  secondaryCtaLabel && secondaryCtaHref ? (
    <Button
      variant="secondary"
      class="btn--lg"
      href={secondaryCtaHref}
      external={secondaryCtaExternal}
    >
      {secondaryCtaLabel}
    </Button>
  ) : null
}
{
  tertiaryCtaLabel && tertiaryCtaHref ? (
  <Button
    variant="secondary"
    class="btn--lg"
    href={tertiaryCtaHref}
    external={tertiaryCtaExternal}
  >
    {tertiaryCtaLabel}
  </Button>
    ) : null
}
