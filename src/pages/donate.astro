---
/**
 * Donate page — Supporting Ghostbusters Virginia's charitable mission.
 */

import CTAs from "../components/CTAs.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import LightboxImageTrigger from "../components/ui/LightboxImageTrigger.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import DonationMeter from "../components/DonationMeter.astro";
import { getResponsiveImageAttrs } from "../lib/images";
import { getSafeHref, isSafeExternalUrl } from "../lib/links";
import { getSiteSettings } from "../lib/settings";
import { getPageCopy } from "../lib/page-copy";

const copy = await getPageCopy("donate");
const settings = await getSiteSettings();

const primaryDonateCtaLabel = "Donate with PayPal";
const secondaryDonateCtaLabel = "Donate for Lymphoma";
const tertiaryDonateCtaLabel = "Donate to Make-A-Wish";
const defaultPaypalDonateUrl = "https://www.paypal.com/US/fundraiser/charity/4434256";
const defaultMakeAWishDonateUrl =
  "https://secure2.wish.org/site/TR?team_id=58435&fr_id=7464&pg=team";
const defaultLymphomaDonateUrl = "https://giving.lymphoma.org/ghostbustersva";
const safePrimaryCtaHref = isSafeExternalUrl(settings.paypalUrl)
  ? settings.paypalUrl
  : defaultPaypalDonateUrl;
const safeSecondaryCtaHref = defaultLymphomaDonateUrl; //
// isSafeExternalUrl(settings.donateUrl)
//   ? settings.donateUrl
//   : defaultMakeAWishDonateUrl;
const safeTertiaryCtaHref = defaultMakeAWishDonateUrl;

const pageTitle = copy.pageTitle || "Support Our Mission";
const pageIntro =
  copy.pageIntro ||
  "Every dollar helps us keep busting ghosts and supporting communities across Virginia.";
const communityHeading = copy.communityHeading || "Community Partners";
const communityText =
  copy.communityText ||
  "Ghostbusters Virginia partners with schools, nonprofits, shelters, and event organizers to bring positive, family-friendly experiences to communities.";
const communityParagraphs = String(communityText)
  .split(/\n\s*\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const communityCtaLabel = copy.communityCtaLabel || "Contact Us";
const communityCtaHref = copy.communityCtaHref || "/contact";
const safeCommunityCtaHref = getSafeHref(communityCtaHref) || "/contact";
const communityImageSrc =
  copy.communityImage || "/images/ghostbusters-virginia-toys-for-tots-drive.jpg";
const communityImageAlt =
  copy.communityImageAlt || "Ghostbusters Virginia members at a Toys for Tots charity drive";
const metaTitle = copy.metaTitle || "Donate";
const metaDescription =
  copy.metaDescription ||
  "Support Ghostbusters Virginia through donations, community partnerships, and volunteer opportunities.";
const ogTitleVal = copy.ogTitle || "Donate | Ghostbusters Virginia";
const ogDescriptionVal =
  copy.ogDescription ||
  "Help fund Ghostbusters Virginia's charitable events and community outreach across the Commonwealth.";
const ogImage = copy.ogImage || "/images/ghostbusters-virginia-toys-for-tots-drive.jpg";

const communityImage = await getResponsiveImageAttrs({
  src: communityImageSrc,
  widths: [640, 960, 1200],
  sizes: "(max-width: 768px) 100vw, 864px",
  width: 1200,
  height: 675,
  quality: 75,
});
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical="/donate"
  ogTitle={ogTitleVal}
  ogDescription={ogDescriptionVal}
  ogImage={ogImage}
>
  <section class="page" aria-labelledby="donate-title">
    <div class="page-band page-band--white">
      <div class="container container--mid">
        <PageHeader id="donate-title" title={pageTitle} subtitle={pageIntro} />
      </div>
    </div>

    <div class="page-band page-band--alt">
      <div class="container container--mid">
        <div class="meter-top">
          <DonationMeter />
        </div>
        <h3 class="meter-caption">
          We support many charities, including the following groups &amp; programs...
        </h3>
        <div class="impact-stats">
          <div class="impact-stat">
            <span class="impact-stat__value">Make-A-Wish VA</span>
            <span class="impact-stat__label"
              >Make-A-Wish Greater Virginia grants life-changing wishes to children facing critical
              illnesses across the Commonwealth. Each wish is funded entirely by community
              giving&mdash;no government support.</span
            >
          </div>
          <div class="impact-stat">
            <span class="impact-stat__value">Toys for Tots</span>
            <span class="impact-stat__label"
              >Created by the Marine Corps Reserve, Toys for Tots collects gifts during the holidays
              and beyond, helping disadvantaged children. Reinforcing the belief that every child
              deserves moments of happiness and a brighter future.
            </span>
          </div>
          <div class="impact-stat">
            <span class="impact-stat__value">Proton Pets</span>
            <span class="impact-stat__label">
              Proton Pets, created by GBVA, is a worldwide initiative supporting pets and animal
              welfare. The program works to make a real difference for both pets and their owners
              while raising awareness about the importance of community pet pantries.
            </span>
          </div>
        </div>
        <div class="donate-section">
          <CTAs
            primaryCtaLabel={primaryDonateCtaLabel}
            primaryCtaHref={safePrimaryCtaHref}
            primaryCtaExternal
            secondaryCtaLabel={secondaryDonateCtaLabel}
            secondaryCtaHref={safeSecondaryCtaHref}
            secondaryCtaExternal
            tertiaryCtaLabel={tertiaryDonateCtaLabel}
            tertiaryCtaHref={safeTertiaryCtaHref}
            tertiaryCtaExternal
          />
        </div>
      </div>
    </div>

    <div class="page-band page-band--white">
      <div class="container container--wide">
        <SectionHeading>{communityHeading}</SectionHeading>
        <div class="zigzag">
          <div class="zigzag__media">
            <LightboxImageTrigger
              group="donate-gallery"
              src={communityImage.src}
              alt={communityImageAlt}
              buttonClass="page-image-lightbox"
              overlayClass="page-image-lightbox__overlay"
            >
              <img
                {...communityImage}
                alt={communityImageAlt}
                class="zigzag__img"
                loading="lazy"
                decoding="async"
              />
            </LightboxImageTrigger>
          </div>
          <div class="zigzag__text">
            <div class="zigzag__copy">
              {communityParagraphs.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
            </div>
            <div class="donate-cta donate-cta--right">
              <Button variant="secondary" href={safeCommunityCtaHref}>
                {communityCtaLabel}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Lightbox
      id="donate-lightbox"
      label="Donate page image viewer"
      lightboxGroup="donate-gallery"
    />
  </section>
</BaseLayout>

<style>
  .prose-text {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    margin-bottom: 0;
  }

  .donate-section {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2xl);
  }

  @media (max-width: 640px) {
    .donate-section {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .donate-section :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }

  .donate-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  .meter-caption {
    margin-top: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-loose);
    text-align: center;
  }

  .meter-top {
    margin-top: 0;
  }

  .impact-stats {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  .impact-stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    box-shadow: var(--shadow-panel);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .impact-stat:hover {
    border-color: var(--color-hover-border);
    box-shadow: var(--shadow-elevated-soft);
    transform: translateY(-2px);
  }

  .impact-stat:hover .impact-stat__value {
    color: var(--color-accent);
  }

  .impact-stat__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    transition: color var(--transition-base);
  }

  .impact-stat__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .zigzag {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: stretch;
  }

  .zigzag__img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    display: block;
  }

  .zigzag__text {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .zigzag__copy {
    display: grid;
    gap: var(--space-md);
  }

  .zigzag__copy .prose-text {
    margin: 0;
  }

  .zigzag__text .donate-cta {
    justify-content: flex-start;
  }

  .zigzag__text .donate-cta--right {
    justify-content: flex-end;
  }

  .container--wide {
    max-width: 960px;
    margin-inline: auto;
    padding-inline: var(--space-xl);
  }

  @media (min-width: 769px) {
    .impact-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-lg);
    }

    .zigzag {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }

    .zigzag--reverse .zigzag__media {
      order: 2;
    }

    .zigzag--reverse .zigzag__text {
      order: 1;
    }
  }

  @media (max-width: 768px) {
    .prose-text--centered-mobile {
      text-align: center;
    }

    .zigzag__copy .prose-text {
      text-align: center;
    }

    .zigzag__text .donate-cta {
      justify-content: center;
    }
  }
</style>
