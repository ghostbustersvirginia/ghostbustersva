---
/**
 * Join page — How to become a member.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import LightboxImageTrigger from "../components/ui/LightboxImageTrigger.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import CardListPanel from "../components/ui/CardListPanel.astro";
import { getResponsiveImageAttrs } from "../lib/images";
import { getPageCopy } from "../lib/page-copy";

const copy = await getPageCopy("join");

const pageTitle = "Join Ghostbusters Virginia";
const pageIntro = "Yes, we're hiring! Here's how to suit up and volunteer with our franchise.";
const quoteLineOne =
  "Are you troubled by hauntingly quiet weekends? Do you experience feelings of wanting\n"+
  "to serve your community? Have you or your family been waiting for a chance to\n"+
  "successfully field-test your ghostbusting equipment?";
const quoteLineTwo =
  "If the answer is yes, then don't wait another minute — we’re ready to hire you!";

const requiredGearHeading = `Appropriate Event Attire Examples`

const requiredGear = [
  "Traditional Ghostbusters uniforms and equipment",
  "Original Ghostbusters-inspired uniforms and character concepts",
  "Costumes based on characters from the films, animated series, comics, or video games",
  "Ghostbusters-themed apparel suitable for volunteer and community events",
];
const metaTitle = copy.metaTitle || "Join";
const metaDescription =
  copy.metaDescription ||
  "Learn membership requirements and how to join Ghostbusters Virginia as an active community volunteer.";
const ogTitleVal = "Join Ghostbusters Virginia";
const ogDescriptionVal =
  "Yes, we're hiring! Here's how to suit up and volunteer with our franchise.";
const ogImage = copy.ogImage || "/images/gallery/Anythings-PAWSible-When-You-Care-Enough.jpg";

const whatWeLookForHeading = `Opportunities Await`;
const whatWeLookForText = `Ghostbusters, Virginia is an all-volunteer organization, which means while there isn’t a
steady paycheck, you will be compensated in the overwhelming sense of pride and
purpose that comes from giving back to your community! So pick up your proton pack,
join the professionals, and help us save the Commonwealth.`;

const whatWeLookForImageSrc = copy.whatWeLookForImage || "/images/gbv-community-photo.jpg";
const whatWeLookForImageAlt =
  copy.whatWeLookForImageAlt || "Ghostbusters Virginia community members in full gear";
const whatWeLookForImage = await getResponsiveImageAttrs({
  src: whatWeLookForImageSrc,
  widths: [640, 960, 1200],
  sizes: "(max-width: 768px) 100vw, 864px",
  width: 1200,
  height: 675,
  quality: 75,
});

const letsTalkImageSrc = "/images/ghostbusters-virginia-ecto-1-cruising.jpg";
const letsTalkImageAlt = "Ghostbusters Virginia members posing with a fan at a comic convention";
const letsTalkImage = await getResponsiveImageAttrs({
  src: letsTalkImageSrc,
  widths: [380, 560, 760],
  sizes: "(max-width: 768px) 100vw, 380px",
  width: 1120,
  height: 2000,
  quality: 75,
});

const letsTalkHeading = `Let's Get to Work`;

const costumeGuidelinesHeading = `Costume Guidelines`;
const costumeIntro = `At Ghostbusters, Virginia, we want to cultivate an inclusive environment where all Ghostbusters fans are welcome to participate in our charity goals. We certainly welcome all canon Ghostbusters uniforms and equipment but we do not make this a requirement to join. The typical flight suit isn't for everyone and we believe it shouldn't act as an exclusion factor for those that are interested in attending events and working at our table to help raise funds for the different charities we work with.`;
const costumeAdvice = `With that in mind, we do suggest for those that do not wish to wear the standard Ghostbusters uniform to get creative and put together a costume or outfit that features Ghostbusters-related logos, artwork, or something you think might exist in the Ghostbusters universe. Another idea is to choose a different character from the films or animated series. We're also happy to help bring your costume or uniform to life, so feel free to ask for advice or ideas!`;
const costumeRequirements = [
  "Appropriate for family-friendly public events",
  "Free of offensive, discriminatory, or explicit content",
  "Safe for both the wearer and those around them",
  "Consistent with the professional image and values of the organization",
];

const backgroundHeading = `Background Screening`;
const backgroundText = `Because members regularly interact with the public, community organizations, and charitable partners, all applicants must successfully complete a background screening with no felonies and do not appear on the National Sex Offender Registry.`;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical="/join"
  ogTitle={ogTitleVal}
  ogDescription={ogDescriptionVal}
  ogImage={ogImage}
>
  <section class="page" aria-labelledby="join-title">
    <div class="page-band page-band--white">
      <div class="container container--mid">
        <PageHeader id="join-title" title={pageTitle} subtitle={pageIntro} />
      </div>
    </div>

    <div class="page-band page-band--alt">
      <div class="container container--mid">
        <blockquote class="quote-block">
          <p>&ldquo;{quoteLineOne}</p>
          <p>{quoteLineTwo}&rdquo;</p>
        </blockquote>
      </div>
    </div>

    <div class="page-band page-band--white">
      <div class="container container--mid">
        <SectionHeading>{whatWeLookForHeading}</SectionHeading>
        <p class="prose-text">
          {whatWeLookForText}
        </p>
      </div>
    </div>

    <div class="page-band page-band--alt">
      <div class="container container--mid">
        <div class="work-layout">
          <div class="work-layout__text">
            <h2 class="work-layout__heading">{letsTalkHeading}</h2>
            <p class="prose-text">
              To apply for membership with Ghostbusters, Virginia, please start by reviewing our
              <a href="https://bit.ly/gbva-charter-link" target="_blank">Charter</a> and
              <a href="https://bit.ly/gbva-code-of-conduct" target="_blank">Code of Conduct</a>.
              These documents describe our mission as a charity organization and what we expect from our members.
            </p>
            <p class="prose-text">
              By joining Ghostbusters, Virginia, you agree to uphold these standards and contribute to a
              positive, inclusive environment for members and the communities we serve.
            </p>
            <p class="prose-text">
              Once you've reviewed these documents, complete our membership application at the link below
              to begin the process.
            </p>
            <div class="join-cta-wrapper">
              <Button
                variant="secondary-alt"
                href="https://docs.google.com/forms/d/e/1FAIpQLSdCixegeyuGucf8A98afdM7AbB3ONHdPQD61PpYztIpRWv67Q/viewform?pli=1"
                external
              >Join Today</Button>
            </div>
          </div>
          <LightboxImageTrigger
            group="join-gallery"
            src={letsTalkImage.src}
            alt={letsTalkImageAlt}
            buttonClass="page-image-lightbox"
            overlayClass="page-image-lightbox__overlay"
          >
            <img
              {...letsTalkImage}
              alt={letsTalkImageAlt}
              class="work-layout__image"
              loading="lazy"
              decoding="async"
            />
          </LightboxImageTrigger>
        </div>
      </div>
    </div>

    <div class="page-band page-band--white">
      <div class="container container--mid">
        <SectionHeading>{costumeGuidelinesHeading}</SectionHeading>
        <p class="prose-text">{costumeIntro}</p>
        <div class="gear-layout">
          <LightboxImageTrigger
            group="join-gallery"
            src={whatWeLookForImage.src}
            alt={whatWeLookForImageAlt}
            buttonClass="page-image-lightbox"
            overlayClass="page-image-lightbox__overlay"
          >
            <img
              {...whatWeLookForImage}
              alt={whatWeLookForImageAlt}
              class="gear-layout__image"
              loading="lazy"
              decoding="async"
            />
          </LightboxImageTrigger>
          <div class="gear-card-column">
            <CardListPanel title={requiredGearHeading} listClass="card-list-panel__list--gear">
              {
                requiredGear.map((item) => (
                  <li>
                    {item}
                  </li>
                ))
              }
            </CardListPanel>

            <CardListPanel title="Requirements" listClass="card-list-panel__list--gear">
              {
                costumeRequirements.map((item) => (
                  <li>
                    {item}
                  </li>
                ))
              }
            </CardListPanel>
          </div>
        </div>
        <p class="prose-text">{costumeAdvice}</p>
        <p class="prose-text costume-note">
          To ensure a positive experience for the public and our charity partners, all costumes,
          props, and attire worn while representing Ghostbusters, Virginia must meet the requirements listed above.
        </p>
        <p class="prose-text reservation-note">
          Ghostbusters, Virginia reserves the right to restrict or prohibit any costume, prop, or
          attire that does not meet these standards during official activities.
        </p>

        <div class="callout" style="margin-top: var(--space-3xl);">
          <h3 class="callout__heading">{backgroundHeading}</h3>
          <p>{backgroundText}</p>
        </div>
      </div>
    </div>
  </section>

  <Lightbox id="join-lightbox" label="Join page image viewer" lightboxGroup="join-gallery" />
</BaseLayout>

<style>
  .prose-text {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
  }

  @media (max-width: 767px) {
    .prose-text {
      text-align: center;
    }
  }

  .quote-block {
    width: 100%;
    max-width: var(--content-width-mid);
    margin-inline: auto;
  }

  .quote-block p {
    font-size: var(--text-base);
  }

  .join-docs-wrapper {
    margin-top: var(--space-sm);
    display: flex;
    justify-content: center;
    gap: 0.5em;
    font-size: 0.8em;
  }

  .join-cta-wrapper {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-2xl);
    text-align: left;
  }

  @media (max-width: 767px) {
    .join-cta-wrapper {
      text-align: center;
    }
  }

  .join-cta-wrapper .btn {
    min-width: 200px;
  }

  .work-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 768px) {
    .work-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .work-layout__heading {
    font-family: var(--font-brand-title);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-heading-section);
    text-transform: uppercase;
    margin-top: 0;
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-xl);
    position: relative;
    text-align: left;
  }

  .work-layout__heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 112px;
    height: 3px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  @media (max-width: 767px) {
    .work-layout__heading {
      text-align: center;
    }

    .work-layout__heading::after {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .work-layout__image {
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 480px;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-md);
    display: block;
  }

  .gear-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .gear-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gear-layout__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  :global(.card-list-panel__list--gear > li) {
    text-transform: capitalize;
  }

  .gear-card-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ---- Sub-list (belt gizmo examples) ---- */
  .sub-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-md);
    margin-left: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sub-list li {
    position: relative;
    padding-left: 1.5rem;
    padding-block: 2px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    cursor: default;
    transition: color var(--transition-base);
  }

  .sub-list li:hover {
    color: var(--color-text);
  }

  .sub-list li::before {
    content: "\2014";
    position: absolute;
    left: 0;
    top: 2px;
    color: var(--color-gb-green);
    font-size: var(--text-xs);
    display: inline-block;
    transition: transform var(--transition-base);
  }

  .sub-list li:hover::before {
    transform: scale(1.4);
  }

  .prose-text + .prose-text {
    margin-top: var(--space-md);
  }

  .costume-note {
    margin-top: var(--space-xl);
  }

  .requirements-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .requirements-list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .requirements-list li::before {
    content: "●";
    position: absolute;
    left: 0;
    color: var(--color-gb-green);
    font-size: 0.6em;
    top: 0.35em;
  }

  .reservation-note {
    margin-top: var(--space-md);
    font-style: italic;
  }

  .callout {
    margin-top: var(--space-2xl);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-xl);
    box-shadow: var(--shadow-panel);
  }

  .callout__heading {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .callout p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-link-hover);
  }
</style>
